# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
#
#   cp .env.example .env
#
# Every variable is optional -- the defaults in src/flight_delay/common/config.py
# are the source of truth. Uncomment only what you want to override.
# All variables are namespaced with FDP_ to avoid colliding with other tooling.

# ---- Secrets ---------------------------------------------------------------
# OpenSky OAuth2 client credentials (plan task 0.7).
# Register at https://opensky-network.org/ -> Account -> API Client.
# Raises the daily credit budget well above the anonymous tier.
# NEVER commit real values. In CI these come from GitHub Actions secrets.
FDP_OPENSKY_CLIENT_ID=
FDP_OPENSKY_CLIENT_SECRET=

# ---- Scope -----------------------------------------------------------------
# Comma-separated ICAO codes. Each MUST have an entry in config/airports.toml.
# Start narrow: more airports means proportionally more OpenSky credits burned.
# FDP_AIRPORTS=KJFK,KEWR,KORD

# Half-width of the OpenSky query box around each airport, in nautical miles.
# Bigger box = more aircraft = more credits. 60 nm comfortably covers the
# approach and holding airspace we care about.
# FDP_BBOX_RADIUS_NM=60

# ---- Poll intervals (seconds) ----------------------------------------------
# Hard floor of 60 s, enforced in config.py: the free OpenSky tier has a daily
# credit budget and a tighter loop will drain it. Raise this if you add airports.
# FDP_OPENSKY_POLL_SECONDS=90

# FDP_METAR_POLL_SECONDS=600
# FDP_TAF_POLL_SECONDS=3600
# FDP_FAA_POLL_SECONDS=300

# ---- Storage ---------------------------------------------------------------
# Root of the local data lake; bronze/silver/gold are derived from it.
# Gitignored. Override in Docker to point at a mounted volume.
# FDP_DATA_DIR=./data

# Airport reference data. Rarely overridden -- useful to point tests at a
# fixture file.
# FDP_AIRPORTS_FILE=./config/airports.toml
