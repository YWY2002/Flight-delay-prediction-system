{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBronze",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::CHANGE-ME-bucket/bronze/*"
    },
    {
      "Sid": "ListBronze",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::CHANGE-ME-bucket",
      "Condition": {"StringLike": {"s3:prefix": "bronze/*"}}
    }
  ]
}
